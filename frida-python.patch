+@dataclass
+class Procedure:
+    name: str
+    c_identifier: str
+    finish_c_identifier: Optional[str]
+    parameters: List[Parameter]
+    throws: bool
+
+    @property
+    def is_async(self) -> bool:
+        return self.finish_c_identifier is not None
