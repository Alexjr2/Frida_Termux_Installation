+
+def _make_class(
+    *,
+    name,
+    c_type,
+    get_type,
+    type_struct,
+    parent,
+    constructors,
+    functions,
+    methods,
+    properties,
+    signals,
+    implements,
+    resolve_type,
+    model,
+):
+    return ClassObjectType(
+        name,
+        c_type,
+        get_type,
+        type_struct,
+        parent,
+        constructors,
+        functions,
+        methods,
