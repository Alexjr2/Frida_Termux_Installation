+FACADE_INTERFACE = (ASSETS_DIR / "facade_interface.py").read_text(encoding="utf-8")
+FACADE_INTERFACE_AIO = (ASSETS_DIR / "facade_interface_aio.py").read_text(encoding="utf-8")
+
+LEGACY_ERROR_MEMBERS = [
+    ("FRIDA_ERROR_SERVER_NOT_RUNNING", "ServerNotRunning"),
+    ("FRIDA_ERROR_EXECUTABLE_NOT_FOUND", "ExecutableNotFound"),
+    ("FRIDA_ERROR_EXECUTABLE_NOT_SUPPORTED", "ExecutableNotSupported"),
